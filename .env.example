# ── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults
DATABASE_URL=postgres://hermes:hermes@localhost:5432/hermes

# ── Solana RPC ──────────────────────────────────────────────────────────────
# Free Helius key recommended (https://helius.dev) — public RPC works but rate-limits hard.
# If HELIUS_API_KEY is set, it takes priority over SOLANA_RPC_URL.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Market data ─────────────────────────────────────────────────────────────
# Birdeye free tier (https://birdeye.so) — optional in M1, used for scoring in M2
BIRDEYE_API_KEY=

# ── Jupiter (quotes / swaps) ────────────────────────────────────────────────
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1

# ── LLM (narrative scoring, Hermes agent) ───────────────────────────────────
ANTHROPIC_API_KEY=

# ── Scanner tuning ──────────────────────────────────────────────────────────
SCOUT_POLL_MS=45000
SCOUT_MIN_LIQUIDITY_USD=10000
SAFETY_TOP10_MAX_PCT=25
SAFETY_SINGLE_HOLDER_MAX_PCT=5
SAFETY_MAX_PRICE_IMPACT_PCT=15
SAFETY_MIN_ROUNDTRIP_RATIO=0.6

# ── Live lane (M5 — leave OFF) ──────────────────────────────────────────────
LIVE_TRADING_ENABLED=false
LIVE_MAX_POSITION_USD=25
LIVE_MAX_CONCURRENT=2
LIVE_DAILY_LOSS_CAP_USD=50
# Throwaway hot wallet ONLY — generated locally, never commit, never fund past the cap
TRADER_WALLET_SECRET_KEY=
